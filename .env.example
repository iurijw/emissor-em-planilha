# Emissor em Planilha: variáveis de ambiente.
#
# Copie para .env (cp .env.example .env), preencha e rode "docker compose up -d".
# Nada aqui é obrigatório na rede local: sem .env o sistema sobe com os padrões.
# Para expor na internet, preencha pelo menos o bloco "Servidor na internet".
# O .env tem segredos: não versione, não envie a ninguém e guarde uma cópia fora do servidor.

# --- Servidor na internet ----------------------------------------------------------------

# 1 liga as proteções de servidor público: webhooks só para https e nunca para a rede interna,
# e o primeiro administrador sempre exige o código de primeiro acesso.
EMISSOR_PUBLICO=1

# Endereço pelo qual as pessoas abrem o sistema, sem barra no fim. Vai nos links de convite e
# de recuperação de senha e no webhook da Stripe. Nunca é tirado do Host da requisição.
EMISSOR_URL_PUBLICA=https://emissor.suaempresa.com.br

# Chave que criptografa o certificado, a senha dele e o 2FA. Sem ela, fica em data/secret.key,
# e um backup da pasta data sozinho abre o certificado. Gere uma vez e NUNCA troque, senão o
# certificado salvo fica ilegível. Para gerar:
#   docker run --rm python:3.12-slim python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Já tem data/secret.key? Copie o conteúdo dele para cá e só então apague o arquivo.
EMISSOR_SECRET_KEY=

# Código para criar o primeiro administrador (abra <URL>/#/primeiro-acesso?token=<código>).
# Vazio: o sistema gera um em data/primeiro-acesso.txt e mostra no log (docker compose logs).
EMISSOR_CONVITE_INICIAL=

# IP ou faixa do proxy HTTPS (Caddy, nginx, Traefik) de quem o sistema aceita o IP real do
# visitante (X-Forwarded-For e X-Forwarded-Proto). Sem isso, todo acesso parece vir do proxy: o
# bloqueio por senhas erradas pega todo mundo junto e EMISSOR_IPS_PERMITIDOS não funciona.
# 172.16.0.0/12 cobre as redes do Docker. Deixe a porta 8000 fechada para a internet (só o
# proxy chega nela), senão alguém poderia inventar o próprio IP.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# Cookie de sessão só por HTTPS. Vazio = automático (HTTPS ou X-Forwarded-Proto: https do proxy).
# 1 força; não use 1 acessando por http://, senão o login não funciona.
EMISSOR_COOKIE_SECURE=

# --- E-mail do "Esqueci minha senha" (opcional) -------------------------------------------
# Sem SMTP (ou sem EMISSOR_URL_PUBLICA), a opção some e o administrador redefine a senha.

EMISSOR_SMTP_HOST=
# Vazio = 587 (starttls) ou 465 (ssl).
EMISSOR_SMTP_PORTA=
# starttls, ssl ou nenhuma.
EMISSOR_SMTP_SEGURANCA=starttls
EMISSOR_SMTP_USUARIO=
EMISSOR_SMTP_SENHA=
EMISSOR_SMTP_REMETENTE=nao-responda@suaempresa.com.br

# --- Acesso e limites (opcional) -----------------------------------------------------------

# Faixas de IP que podem abrir o sistema, separadas por vírgula (ex.: 192.168.0.0/24). Vazio = todas.
# Atrás de proxy, só funciona com FORWARDED_ALLOW_IPS certo.
EMISSOR_IPS_PERMITIDOS=

# Quantas empresas (CNPJs) a instalação pode ter. Vazio = sem limite.
EMISSOR_LIMITE_EMPRESAS=

# Limites da API de integração (/api/v1) por token.
EMISSOR_API_LIMITE_MINUTO=60
EMISSOR_API_LIMITE_NOTAS_DIA=1000

# --- Outros (opcional) ---------------------------------------------------------------------

# Pasta com Arial/Microsoft Sans Serif para o DANFSe (montada no docker-compose.yaml).
# Vazio = Liberation Sans, de mesmas medidas.
EMISSOR_FONT_DIR=

# Fork do projeto: repositório consultado para avisar de versões novas.
# EMISSOR_REPOSITORIO=iurijw/emissor-em-planilha

# Já definidos pelo Dockerfile/docker-compose.yaml; mude só se souber o motivo:
# TZ=America/Sao_Paulo  EMISSOR_DATA_DIR=/data  EMISSOR_HOST=0.0.0.0  EMISSOR_PORT=8000

# Não use: FLY_APP_NAME, EMISSOR_SUSPENSO, EMISSOR_URL_ASSINATURA, EMISSOR_ASSINATURA_API,
# EMISSOR_EMAIL_URL, EMISSOR_EMAIL_TOKEN e EMISSOR_WHATSAPP_SUPORTE são da hospedagem oficial
# (emissoremplanilha.com). EMISSOR_WHATSAPP_SUPORTE (número com DDD) mostra o botão de suporte pelo WhatsApp.
